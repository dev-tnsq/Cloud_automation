

# Azure Configuration
AZURE_CREDENTIALS_FILE_PATH=/path/to/azure/credentials.json

# GCP Configuration

GCP_CREDENTIALS_FILE_PATH=/path/to/gcp/credentials.json

# Utilization alert thresholds
# Alert when average VM CPU utilization falls below this percentage
CPU_THRESHOLD=10
# Alert when disk usage rises above this percentage
DISK_THRESHOLD=90
# Metric lookback window (hours) for utilization checks
ALERT_LOOKBACK_HOURS=24
# Optional: webhook URL to post alerts to (e.g. Slack incoming webhook)
ALERT_WEBHOOK_URL=
